# Copy to .env (gitignored) and fill in locally. Never commit real values.
# In CI, set these as GitHub Actions secrets.

# Runtime mode: paper | live. Default paper.
TRADING_MODE=paper

# HTTP client identity (SEC requires a contact email in the User-Agent)
HTTP_USER_AGENT=

# Data sources
MASSIVE_API_KEY=
TIINGO_API_KEY=
FRED_API_KEY=
STOOQ_API_KEY=
OPENFIGI_API_KEY=

# Broker: paper only. Live credentials use different names and never live here.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
